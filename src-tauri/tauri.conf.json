{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodic Studio",
  "version": "0.1.0",
  "identifier": "dev.melodic.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melodic Studio",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A desktop git client.",
    "longDescription": "Commit, branch, sync and browse history for your git repositories.",
    "copyright": "Copyright © 2026 Melodic Development",
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "minimumWebview2Version": "114.0.0.0" },
    "linux": {
      "deb": { "depends": ["git", "libwebkit2gtk-4.1-0 (>= 2.42)"], "recommends": ["xdg-utils"], "section": "devel" },
      "rpm": { "depends": ["git"] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
